# Rotate the cron job logs. Install with (replace the path with your LOGS_DIR):
#   sed 's|@LOGS_DIR@|/path/to/logs|' logrotate.conf.template | sudo tee /etc/logrotate.d/homeserver-borgmatic
@LOGS_DIR@/*.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
